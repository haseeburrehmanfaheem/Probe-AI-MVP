{
  "model": "NAUTILUS-MOTION-SENSOR",
  "aliases": [
    "nautilus motion sensor",
    "motion sensor",
    "motion",
    "pir",
    "pir sensor",
    "motion_sensor"
  ],
  "vendor": "Arduino MEGA 2560 running webui/tools/motion_sensor/motion_sensor.ino (a PIR module on pin 2)",
  "type": "PIR-style motion sensor (presence level 0-1 plus a motion flag)",
  "protocol": "UART (TTL)",
  "interface": "ttl",
  "supply_voltage": "powered from its own USB cable; only GND is shared with the probe cube",
  "sim_device": "motion",
  "pins": [
    {
      "name": "TX1 (pin 18)",
      "signal": "UART_TX",
      "description": "Sensor transmits data"
    },
    {
      "name": "RX1 (pin 19)",
      "signal": "UART_RX",
      "description": "Sensor receives commands"
    },
    {
      "name": "GND",
      "signal": "GND",
      "description": "Common ground, mandatory"
    }
  ],
  "uart": {
    "default_baud": 9600,
    "supported_baud": [
      9600
    ],
    "data_bits": 8,
    "parity": "n",
    "stop_bits": "1"
  },
  "recommended_settings": {
    "baud": 9600,
    "data_bits": 8,
    "parity": "n",
    "stop_bits": "1",
    "rate_ms": 100
  },
  "framing": {
    "type": "line",
    "pattern": "^\\$MOTN,L=\\d+\\.\\d+,M=[01],SEQ=\\d+\\*$"
  },
  "stream": {
    "start_api": "stream_on",
    "stop_api": "stream_off",
    "sequence_field": "SEQ"
  },
  "fields": {
    "L": {
      "unit": "level",
      "range": [
        0,
        1
      ],
      "description": "smoothed presence level"
    },
    "M": {
      "unit": "",
      "range": [
        0,
        1
      ],
      "description": "motion flag"
    }
  },
  "commands": {
    "ID?": "identity string",
    "READ": "one reading",
    "START / STOP": "stream on / off",
    "RATE <ms>": "stream period, min 100",
    "PING": "replies PONG",
    "ECHO <text>": "replies <text>"
  },
  "apis": {
    "sensor_ping": {
      "description": "Link check: send PING to the sensor and wait for PONG.",
      "command": "send {port} PING",
      "expect": "^\\[{port}\\] TX \\d+B$",
      "sensor_expect": "^PONG$"
    },
    "sensor_id": {
      "description": "Ask the sensor for its identity string.",
      "command": "send {port} ID?",
      "expect": "^\\[{port}\\] TX \\d+B$",
      "sensor_expect": "^NAUTILUS-"
    },
    "sensor_read": {
      "description": "Request one reading from the sensor.",
      "command": "send {port} READ",
      "expect": "^\\[{port}\\] TX \\d+B$",
      "sensor_expect_reading": true
    },
    "set_rate": {
      "description": "Set the sensor's stream period in milliseconds (minimum 100).",
      "command": "send {port} RATE {rate_ms}",
      "params": {
        "rate_ms": {
          "type": "integer",
          "description": "Stream period in ms, at least 100"
        }
      },
      "expect": "^\\[{port}\\] TX \\d+B$",
      "sensor_expect": "^OK RATE \\d+$",
      "changes_sensor": true
    },
    "sensor_echo": {
      "description": "Loopback integrity check: the sensor sends the text back.",
      "command": "send {port} ECHO {text}",
      "params": {
        "text": {
          "type": "string",
          "max_length": 50,
          "description": "Printable ASCII, single spaces"
        }
      },
      "expect": "^\\[{port}\\] TX \\d+B$",
      "sensor_expect": "^{text}$"
    },
    "stream_on": {
      "description": "Start the sensor's periodic stream of readings.",
      "command": "send {port} START",
      "expect": "^\\[{port}\\] TX \\d+B$",
      "sensor_expect": "^OK STREAM ON$"
    },
    "stream_off": {
      "description": "Stop the sensor's periodic stream of readings.",
      "command": "send {port} STOP",
      "expect": "^\\[{port}\\] TX \\d+B$",
      "sensor_expect": "^OK STREAM OFF$"
    }
  },
  "verify_apis": [
    "ports",
    "sensor_ping"
  ],
  "data": "Streams $MOTN,L=<level 0.00-1.00>,M=<0|1>,SEQ=<n>* frames (period set by RATE). L is a smoothed presence level that rises toward ~0.85 while something moves and decays to ~0.05 when the scene is still. M is 1 while motion is detected (on above 0.5, off below 0.3). SEQ increments by 1 per frame.",
  "views": [
    {
      "kind": "motion",
      "title": "Presence",
      "level": "L",
      "flag": "M"
    }
  ],
  "sim_action": {
    "label": "Simulate motion",
    "busy_label": "Moving…",
    "seconds": 2.5
  },
  "test_plan": [
    {
      "name": "motion",
      "instruction": "Wave your hand in front of the sensor for a couple of seconds.",
      "seconds": 6,
      "expect": "Samples arrive. M reaches 1 at least once and L max > 0.5. seq_gaps 0.",
      "checks": [
        {
          "fields": "^L$",
          "stat": "max",
          "op": ">",
          "value": 0.5,
          "label": "L max > 0.5"
        },
        {
          "fields": "^M$",
          "stat": "max",
          "op": ">",
          "value": 0.5,
          "label": "motion flag M reached 1"
        },
        {
          "source": "result",
          "fields": "seq_gaps",
          "op": "<",
          "value": 1,
          "label": "no missed frames (seq_gaps 0)"
        }
      ]
    },
    {
      "name": "clear",
      "instruction": "Step away and keep the area in front of the sensor still.",
      "seconds": 5,
      "expect": "Samples arrive. M stays 0 and L max < 0.35 (it may start a little higher while decaying).",
      "checks": [
        {
          "fields": "^M$",
          "stat": "max",
          "op": "<",
          "value": 0.5,
          "label": "motion flag M stays 0"
        },
        {
          "source": "result",
          "fields": "seq_gaps",
          "op": "<",
          "value": 1,
          "label": "no missed frames (seq_gaps 0)"
        }
      ]
    }
  ],
  "recommended_notes": {
    "baud": "the sketch is fixed at 9600 8N1",
    "rate_ms": "a faster stream than the 1 s default gives the tests more samples"
  }
}

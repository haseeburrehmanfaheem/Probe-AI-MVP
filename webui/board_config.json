{
  "board": "STM32 Nucleo-F401RE (Probe Cube)",
  "transport": {
    "type": "sim",
    "port": "/dev/cu.usbmodemXXXX",
    "baud_rate": 115200,
    "timeout_seconds": 0.1,
    "open_delay_seconds": 0.5
  },
  "line_ending": "\n",
  "command_timeout_seconds": 2,
  "error_pattern": "^ERR",
  "apis": {
    "ping": {
      "description": "Check the board is alive.",
      "command": "PING",
      "expect": "^PONG"
    },
    "get_config": {
      "description": "Read back the current sensor UART configuration of the board.",
      "command": "GET_CONFIG",
      "expect": "^CONFIG,"
    },
    "set_baud": {
      "description": "Set the baud rate of the UART connected to the sensor.",
      "command": "SET_BAUD,{baud}",
      "params": {"baud": {"type": "integer", "description": "Baud rate, e.g. 9600 or 115200"}},
      "expect": "^ACK,SET_BAUD"
    },
    "set_parity": {
      "description": "Set the parity of the sensor UART.",
      "command": "SET_PARITY,{parity}",
      "params": {"parity": {"type": "string", "enum": ["N", "E", "O"], "description": "N=none, E=even, O=odd"}},
      "expect": "^ACK,SET_PARITY"
    },
    "set_stop_bits": {
      "description": "Set the number of stop bits of the sensor UART.",
      "command": "SET_STOP_BITS,{stop_bits}",
      "params": {"stop_bits": {"type": "integer", "enum": [1, 2]}},
      "expect": "^ACK,SET_STOP_BITS"
    },
    "set_ack": {
      "description": "Enable (1) or disable (0) acknowledgement of commands sent to the sensor.",
      "command": "SET_ACK,{enabled}",
      "params": {"enabled": {"type": "integer", "enum": [0, 1]}},
      "expect": "^ACK,SET_ACK"
    },
    "stream_on": {
      "description": "Start streaming decoded sensor data lines.",
      "command": "STREAM_ON",
      "expect": "^ACK,STREAM_ON"
    },
    "stream_off": {
      "description": "Stop streaming sensor data.",
      "command": "STREAM_OFF",
      "expect": "^ACK,STREAM_OFF"
    }
  },
  "sampling": {
    "start_api": "stream_on",
    "stop_api": "stream_off",
    "data_line_pattern": "^(ACCEL|GYRO),",
    "lead_seconds": 3
  },
  "probe_cube_ports": [
    {"label": "X", "accepts": "UART_TX", "mcu_pin": "PA10", "mcu_function": "USART1_RX"},
    {"label": "Y", "accepts": "UART_RX", "mcu_pin": "PA9", "mcu_function": "USART1_TX"},
    {"label": "5V", "accepts": "VCC_5V", "mcu_pin": "5V", "mcu_function": "Power"},
    {"label": "GND", "accepts": "GND", "mcu_pin": "GND", "mcu_function": "Ground"}
  ]
}
